# EmailJS credentials for the registration form (src/sections/Register.jsx).
# Copy this file to `.env.local` (git-ignored) and fill in the values from
# your EmailJS dashboard. Restart `pnpm dev` after changing them.
#
# These are exposed in the client bundle by design - the public key is meant
# for browser use and EmailJS rate-limits per key / per domain.

# EmailJS > Email Services > (your service)
VITE_EMAILJS_SERVICE_ID=

# EmailJS > Email Templates > (create one; its variables are the form field
# names: {{name}} {{email}} {{phone}} {{interest}} {{message}})
VITE_EMAILJS_TEMPLATE_ID=

# EmailJS > Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=
